#!/usr/bin/env bash
# Wrapper to run PoliTO Agent using its virtual environment
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

VENV_PY="$SCRIPT_DIR/.venv/bin/python3"
if [ ! -x "$VENV_PY" ] || ! "$VENV_PY" -c "import rich, pypdf, onnx_asr" 2>/dev/null; then
  echo "Ambiente Python .venv non valido o incompleto in $SCRIPT_DIR." >&2
  echo "Ricrea le dipendenze con: cd \"$SCRIPT_DIR\" && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

exec "$VENV_PY" "$SCRIPT_DIR/cli.py" "$@"
