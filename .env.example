# Credenziali Portale della Didattica PoliTO (opzionali se usi `polito login --manual`)
POLITO_USERNAME=s123456
POLITO_PASSWORD=la_tua_password_qui

# Cartella di destinazione per i file organizzati
POLITO_OUTPUT_DIR=~/Desktop/PoliTO

# Configurazione LLM OpenAI-compatibile (OpenRouter, OpenAI, Ollama, ecc.)
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=
MODEL_NAME=google/gemini-2.5-pro

# Opzionale: Chiave API Gemini diretta (usata se API_KEY non e' impostata)
GEMINI_API_KEY=

# Configurazione trascrizione locale faster-whisper
WHISPER_MODEL_EN=distil-medium.en
WHISPER_MODEL_IT=medium
WHISPER_COMPUTE_TYPE=int8
